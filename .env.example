# ── PosServer — configuración de entorno ──────────────────────────────────
# Copia este archivo a `.env` y ajusta los valores a tu entorno local.
# PostgreSQL se configura SOLO en localhost (127.0.0.1:5432) según el PRD:
# nunca debe exponerse a la red.

# Puerto HTTP del API (los clientes POS se conectan aquí)
PORT=3000

# Host donde escucha el API. En la sucursal local se usa 0.0.0.0 para que
# tablets/PCs de la LAN puedan alcanzarlo (firewall: solo perfil "Privado").
HOST=0.0.0.0

# Conexión a PostgreSQL 16 (fuente única de verdad, multi-tenant).
# El esquema autoritativo es esquema_BD_POS_v4_completo.sql (raíz del repo).
# Se usa SOLO cuando DB_PROVIDER=postgres (producción).
DATABASE_URL=postgres://pos:pos@127.0.0.1:5432/pos

# Proveedor de base de datos: 'sqlite' (dev/pruebas, misma estructura que PG)
# o 'postgres' (producción). El default es postgres según el PRD; para
# desarrollo sin PostgreSQL instalado, copia .env y pon DB_PROVIDER=sqlite.
DB_PROVIDER=postgres

# Ruta del archivo SQLite (solo cuando DB_PROVIDER=sqlite).
# El directorio se crea automáticamente; ignorado por .gitignore.
SQLITE_PATH=./data/pos.sqlite
# Pool de lectura SQLite configurable 2-4 (default 3), WAL por defecto
SQLITE_POOL_READ_SIZE=3
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_SYNCHRONOUS=NORMAL
SQLITE_CACHE_SIZE_KB=-64000
SQLITE_MMAP_SIZE=33554432

# Secreto para firmar los JWT (24h) + refresh. Genera uno propio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-genera-un-secreto-de-64-hex

# Vigencia del access token en segundos (24h por PRD)
JWT_EXPIRES_IN=86400

# Máximo de dispositivos registrados por tenant (por defecto 2 según PRD)
DEVICE_LIMIT_DEFAULT=2

# Nivel de log del servidor (trace|debug|info|warn|error)
LOG_LEVEL=info

# ── Imágenes de productos (RustFS/Garage S3, S3-compatible) ──────────────
# IMAGES_ENABLED=false desactiva el módulo (endpoints de imagen → 503),
# útil para dev/tests sin S3 corriendo.
# Dev: RustFS en Docker (pos-rustfs/docker-compose.yml → :3900).
# Prod: binario nativo rustfs.exe --service (sin Docker). Bucket canónico pos-images.
IMAGES_ENABLED=true

# Endpoint API S3 (autenticado, lo usa el S3Client con forcePathStyle)
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GK233202b64ff1280fabb72582
S3_SECRET_ACCESS_KEY=4a725c042b6f23cda5620a9eaf66a2791984962a61b5ba109836da5fc75e7e2a
S3_BUCKET=pos-images

# URL pública directa para LEER las imágenes (las tablets cargan desde aquí)
S3_PUBLIC_URL=http://127.0.0.1:3902

# Tamaño máximo por imagen en MB (default 5)
S3_MAX_FILE_SIZE_MB=5

# ── Sistema de licencias firmadas (Ed25519) ───────────────────────────────
# Ruta del archivo .lic firmado (fuera de la carpeta de programa para sobrevivir
# a updates). Windows: %ProgramData%\POS Server\data\pos.lic
# Linux: /var/lib/pos-server/pos.lic
LICENSE_FILE_PATH=

# Ruta a la clave pública PEM (solo dev). En producción se embebe al build.
# No cambiar a una ruta editable por el cliente.
# Rutas relativas a la carpeta pos-server. Si se deja vacío, el build busca la
# clave en: pos-server/keys/ → tools/keys/ → tools-posky/keys/
PUBLIC_KEY_PATH=
# Clave pública de la familia trial (licencias trial 1 día). Misma lógica.
TRIAL_PUBLIC_KEY_PATH=
# Clave PRIVADA de la familia trial (solo para emitir el trial de 1 día).
# NO debe existir en el servidor del cliente final.
TRIAL_PRIVATE_KEY_PATH=
# Passphrase de la clave privada trial (si el PEM está cifrado). Vacío = PEM
# sin cifrar (solo en desarrollo).
TRIAL_PASS=
# Si true, la falta de .lic bloquea el tenant (prod). false = degradado (dev).
# IMPORTANTE: el `.env` queda en modo producción (true). El modo desarrollo
# lo activa el script `npm run dev` / `npm test` con LICENSE_DEV_MODE=true
# (inyectado con cross-env) — NO lo pongas aquí.
LICENSE_STRICT=true
# Modo desarrollo: la licencia NUNCA bloquea al tenant (reactiva y extiende
# la vigencia). Lo inyecta el script de npm; no lo definas en el `.env`.
# Si lo defines, se ignora en NODE_ENV=production.
# LICENSE_DEV_MODE=true
# Días de vigencia de la licencia cuando el modo dev la extiende (default 365).
# LICENSE_DEV_DAYS=365
# Habilita POST /license/trial (trial de 1 día). En modo estricto queda
# cerrado automáticamente; el instalador de Windows lo fija en false.
TRIAL_ENABLED=true
# Secreto para HMAC anti-rollback (si no se fija, deriva de JWT_SECRET; rotar JWT no debe invalidar HMAC en prod -> fijar aqui)
LICENSE_HMAC_SECRET=

# ── Seed demo ─────────────────────────────────────────────────────────────
# Días de vigencia de la licencia del tenant demo al sembrar (default 365).
# El instalador prod la fija en 0 (ya vencida) para que la instalación fresca
# arranque en bootstrap (wizard de activación) en vez de "activa" sin .lic.
# SEED_DEMO_LICENSE_DAYS=365