# ── Dependencias ───────────────────────────────────────────────
node_modules/

# ── Build de TypeScript ─────────────────────────────────────────
dist/
*.tsbuildinfo

# ── Clave pública embebida (generada por scripts/generatePublicKey.js) ─
src/keys/publicKey.ts

# ── Clave privada de test (generada por tests/global-setup.ts) ─
tests/test-private.pem

