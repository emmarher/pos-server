data/
*.lic

# ── Entorno local (nunca versionar secretos) ────────────────────
.env
.env.*
!.env.example

# ── SQLite de desarrollo/pruebas (se migra a PostgreSQL en prod) ─
data/
*.sqlite
*.sqlite3
*.db

# ── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS / editores ───────────────────────────────────────────────
