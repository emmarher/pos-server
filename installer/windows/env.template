# installer/windows/env.template — Plantilla .env del instalador POS Server.
#
# El wizard de Inno Setup (`pos-server.iss`) copia esta plantilla a `{app}\.env`
# sustituyendo las marcas {{...}}:
#   {{PORT}}            puerto API elegido en el wizard (default 3000)
#   {{JWT_SECRET}}      64-hex aleatorio generado al instalar (obligatorio)
#   {{HMAC_SECRET}}     64-hex aleatorio para HMAC anti-rollback (no derivar de JWT en prod)
#   {{SQLITE_PATH}}     ruta del sqlite en %ProgramData% (escapada para Inno)
#   {{LICENSE_FILE}}    ruta del .lic en %ProgramData% (escapada para Inno)
#   {{IMAGES_ENABLED}}  toggle del wizard (default false en v1)
#
# NUNCA versionar el .env generado (tiene secretos) — ver .gitignore.

# ── Red ──────────────────────────────────────────────────────────────────
PORT={{PORT}}
HOST=0.0.0.0

# ── Base de datos: SQLite local por sucursal (producción local v1) ───────
DB_PROVIDER=sqlite
SQLITE_PATH={{SQLITE_PATH}}

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET={{JWT_SECRET}}
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=2592000
DEVICE_LIMIT_DEFAULT=2
LOG_LEVEL=info

# ── Imágenes (Garage/S3): desactivadas en v1 (sin S3 embebido) ───────────
IMAGES_ENABLED={{IMAGES_ENABLED}}

# ── Licencias firmadas Ed25519 (prod) ────────────────────────────────────
# .lic fuera de la carpeta de programa para sobrevivir a updates.
LICENSE_FILE_PATH={{LICENSE_FILE}}
# En prod la pública va embebida al build (build:keys); dejar vacío.
PUBLIC_KEY_PATH=
# true = sin .lic válido el tenant se bloquea.
LICENSE_STRICT=true
# Fijo e independiente de JWT_SECRET (rotar JWT no debe invalidar el HMAC).
LICENSE_HMAC_SECRET={{HMAC_SECRET}}

# ── Seed ─────────────────────────────────────────────────────────────────
# 0 = el tenant demo nace vencido → la instalación fresca arranca en
# bootstrap (wizard de activación) en vez de "activa" sin .lic.
SEED_DEMO_LICENSE_DAYS=0
